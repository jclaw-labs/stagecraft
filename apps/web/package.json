{
  "name": "@stagecraft/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-template-bundle.mjs",
    "dev": "npm run generate && sh -c 'set -a && . ./.op.env && exec next dev --turbopack'",
    "build": "npm run generate && next build",
    "build:worker": "opennextjs-cloudflare build && wrangler deploy --dry-run --outdir .open-next/dist",
    "deploy:worker": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run generate && vitest run",
    "typecheck": "npm run generate && tsc --noEmit",
    "capture:screenshots": "npm run generate && playwright test --config playwright.capture.config.ts",
    "capture:screenshots:public": "npm run build && playwright test --config playwright.public-capture.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@stagecraft/db": "*",
    "@stagecraft/queue": "*",
    "@stagecraft/shared": "*",
    "jose": "^6.2.3",
    "next": "^15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3",
    "wrangler": "^4.149.0"
  }
}
