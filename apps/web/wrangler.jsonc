// Cloudflare Worker config for the platform app, built with
// `npm run build:worker` (OpenNext) and deployed with `npm run deploy:worker`
// or the "Deploy Worker" workflow (.github/workflows/deploy-worker.yml).
//
// Preview only: the Worker is served at stagecraft.<account>.workers.dev.
// Don't add `routes` or custom domains here; stagecraft.website stays on
// Netlify until the cutover (#312). cloudflare/wrangler-config.test.ts
// enforces both.
//
// Secrets never go in `vars`. They are Worker secrets, set with
// `wrangler secret put` / `wrangler secret bulk` and kept across deploys.
// The list is in docs/runbook.md ("Cloudflare Worker").
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stagecraft",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // No long-lived process on Workers: the Cron Trigger below drains the
    // job queue through POST /api/cron/jobs (see cloudflare/scheduled.ts).
    "STAGECRAFT_INPROCESS_WORKER": "false",
    // Workers can't open the TCP socket Prisma's default engine needs, so
    // the client talks to Neon over WebSockets (packages/db/src/driver.ts).
    "DATABASE_DRIVER": "neon"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
