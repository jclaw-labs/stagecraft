{
  "name": "@jclaw-labs/content-upgraders",
  "version": "1.0.0-rc.0",
  "description": "Upgrades Stagecraft musician-site content from one collection schemaVersion to the next.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jclaw-labs/stagecraft.git",
    "directory": "packages/content-upgraders"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  }
}
