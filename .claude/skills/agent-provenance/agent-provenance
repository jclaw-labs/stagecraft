#!/usr/bin/env python3
import argparse
import base64
import binascii
import hashlib
import html
import json
import os
import re
import sys
import tempfile
import unicodedata

EFFORTS = ("none", "minimal", "low", "medium", "high", "xhigh", "max")
TARGETS = ("cloud", "local", "either", "both")
EFFORT_RE = re.compile(
    rf"-(?P<effort>{'|'.join(EFFORTS)})(?:-fast)?$"
)
VERSION_RE = re.compile(r"^\d+(?:\.\d+)+$")
PARAM_IDS = ("effort", "reasoning", "reasoning_effort", "thinking_level")
START = "<!-- agent-context:start -->"
END = "<!-- agent-context:end -->"
RECORD_PREFIX = "<!-- agent-context:v1:"
LINEAR_HEADING = "+++ Agent context"
MODEL_FIELDS = {
    "runtime_id",
    "lab",
    "line",
    "version",
    "modifiers",
    "effort",
}


class ProvenanceError(ValueError):
    pass


def title_modifier(value: str) -> str:
    return value.replace("_", " ").replace("-", " ").title()


def split_effort(
    tokens: list[str],
    explicit: str | None,
) -> tuple[list[str], str | None]:
    fast = tokens[-1:] == ["fast"]
    if fast:
        tokens = tokens[:-1]
    derived = tokens[-1] if tokens and tokens[-1] in EFFORTS else None
    if derived is not None:
        tokens = tokens[:-1]
    if explicit is not None and derived is not None and explicit != derived:
        raise ProvenanceError(
            f"explicit effort {explicit} conflicts with model effort {derived}"
        )
    effort = explicit or derived
    if fast:
        tokens.append("fast")
    return tokens, effort


def parse_gpt(
    tokens: list[str],
    explicit_effort: str | None,
) -> tuple[str, str, str, list[str], str | None] | None:
    tokens, effort = split_effort(tokens, explicit_effort)
    if not tokens or VERSION_RE.fullmatch(tokens[0]) is None:
        return None
    return (
        "OpenAI",
        "GPT",
        tokens[0],
        [title_modifier(token) for token in tokens[1:]],
        effort,
    )


def parse_claude_opus(
    tokens: list[str],
    explicit_effort: str | None,
) -> tuple[str, str, str, list[str], str | None] | None:
    tokens, effort = split_effort(tokens, explicit_effort)
    version_tokens = []
    while tokens and tokens[0].isdigit():
        version_tokens.append(tokens.pop(0))
    if not version_tokens:
        return None
    return (
        "Anthropic",
        "Opus",
        ".".join(version_tokens),
        [title_modifier(token) for token in tokens],
        effort,
    )


