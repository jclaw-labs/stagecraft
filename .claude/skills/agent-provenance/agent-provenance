def parse_cursor_grok(
    tokens: list[str],
    explicit_effort: str | None,
) -> tuple[str, str, str, list[str], str | None] | None:
    tokens, effort = split_effort(tokens, explicit_effort)
    if not tokens or VERSION_RE.fullmatch(tokens[0]) is None:
        return None
    modifiers = ["Cursor"]
    modifiers.extend(title_modifier(token) for token in tokens[1:])
    return "xAI", "Grok", tokens[0], modifiers, effort


def parse_muse(
    tokens: list[str],
    explicit_effort: str | None,
) -> tuple[str, str, str, list[str], str | None] | None:
    tokens, effort = split_effort(tokens, explicit_effort)
    version_index = next(
        (
            index
            for index, token in enumerate(tokens)
            if VERSION_RE.fullmatch(token) is not None
        ),
        None,
    )
    if version_index is None:
        return None
    modifier_tokens = tokens[:version_index] + tokens[version_index + 1:]
    return (
        "Cursor",
        "Muse",
        tokens[version_index],
        [title_modifier(token) for token in modifier_tokens],
        effort,
    )


