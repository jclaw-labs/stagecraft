#!/usr/bin/env python3

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import NoReturn


FIELD_KEYS = ("priority", "queue", "blocked_by", "touches", "claim")
FIELD_TYPES = {
    "priority": "IssueFieldSingleSelect",
    "queue": "IssueFieldSingleSelect",
    "blocked_by": "IssueFieldText",
    "touches": "IssueFieldText",
    "claim": "IssueFieldText",
}
API_VERSION = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
REPOSITORY = re.compile(r"^[^/\s]+/[^/\s]+$")
VALUE_DATA_TYPES = {
    "IssueFieldSingleSelect": "single_select",
    "IssueFieldText": "text",
}
ISSUES_PAGE_SIZE = 100
ISSUE_READ_ATTEMPTS = 3
GRAPHQL_REFUSED = "GraphQL is not available"
FIELDS_QUERY = """
query($owner: String!, $name: String!, $endCursor: String) {
  repository(owner: $owner, name: $name) {
    issueFields(first: 100, after: $endCursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        __typename
        ... on IssueFieldSingleSelect { fullDatabaseId name }
        ... on IssueFieldText { fullDatabaseId name }
        ... on IssueFieldDate { fullDatabaseId name }
        ... on IssueFieldNumber { fullDatabaseId name }
        ... on IssueFieldMultiSelect { fullDatabaseId name }
      }
    }
  }
}
"""


def die(message: str, code: int = 1) -> NoReturn:
    print(f"issue-fields: {message}", file=sys.stderr)
    raise SystemExit(code)


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:
        die(message, 64)


def load_json(path: str) -> object:
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        die(f"cannot read profile: {error}", 64)


def load_profile(path: str) -> dict[str, object]:
    profile = load_json(path)
    if not isinstance(profile, dict) or profile.get("backend") != "github-issues":
        die("profile must use the github-issues backend", 64)
    tracker = profile.get("tracker")
    if not isinstance(tracker, dict):
        die("profile tracker must be an object", 64)
    repository = tracker.get("repository")
    version = tracker.get("api_version")
    fields = tracker.get("fields")
    if not isinstance(repository, str) or REPOSITORY.fullmatch(repository) is None:
        die("profile repository must be owner/name", 64)
    if not isinstance(version, str) or API_VERSION.fullmatch(version) is None:
        die("profile api_version must be YYYY-MM-DD", 64)
    if not isinstance(fields, dict) or set(fields) != set(FIELD_KEYS):
        die("profile fields must contain priority, queue, blocked_by, touches, and claim", 64)
    values = list(fields.values())
    if any(isinstance(value, bool) or not isinstance(value, int) or value <= 0 for value in values):
        die("profile field ids must be positive integers", 64)
    if len(values) != len(set(values)):
        die("profile field ids must be unique", 64)
    owner, name = repository.split("/", 1)
    return {
        "owner": owner,
        "name": name,
        "api_version": version,
        "fields": fields,
    }


class GitHubError(Exception):
    pass


def gh_call(
    arguments: list[str],
    api_version: str,
    input_value: object | None = None,
    allow_empty: bool = False,
) -> object | None:
    command = ["gh", "api", *arguments, "-H", f"X-GitHub-Api-Version: {api_version}"]
    encoded = None
    if input_value is not None:
        command.extend(["--input", "-"])
        encoded = json.dumps(input_value, separators=(",", ":"))
    result = subprocess.run(command, input=encoded, text=True, capture_output=True)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise GitHubError(f"GitHub API failed: {detail}")
    if not result.stdout.strip():
        if allow_empty:
            return None
        raise GitHubError("GitHub API returned an empty response")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise GitHubError(f"GitHub API returned invalid JSON: {error}") from error
    if isinstance(value, dict) and value.get("errors"):
        raise GitHubError(
            f"GitHub GraphQL failed: {json.dumps(value['errors'], separators=(',', ':'))}"
        )
    return value


def gh_json(
    arguments: list[str],
    api_version: str,
    input_value: object | None = None,
    allow_empty: bool = False,
) -> object | None:
    try:
        return gh_call(arguments, api_version, input_value, allow_empty)
    except GitHubError as error:
        die(str(error))


def graphql(
    profile: dict[str, object],
    query: str,
    cursor: str | None = None,
) -> dict[str, object]:
    arguments = [
        "graphql",
        "-H",
        "GraphQL-Features: issue_fields,repo_issue_fields",
        "-f",
        f"query={query}",
        "-f",
        f"owner={profile['owner']}",
        "-f",
        f"name={profile['name']}",
    ]
    if cursor is not None:
        arguments.extend(["-f", f"endCursor={cursor}"])
    value = gh_call(arguments, str(profile["api_version"]))
    if not isinstance(value, dict):
        die("GitHub GraphQL response must be an object")
    return value


def field_names(profile: dict[str, object]) -> dict[str, str] | None:
    # None when the proxy refuses GraphQL; value reads check types instead.
    by_id: dict[int, tuple[str, str]] = {}
    cursor = None
    seen_cursors: set[str] = set()
    while True:
        try:
            value = graphql(profile, FIELDS_QUERY, cursor)
        except GitHubError as error:
            if GRAPHQL_REFUSED in str(error):
                return None
            die(str(error))
        repository = value.get("data", {}).get("repository")
        connection = repository.get("issueFields") if isinstance(repository, dict) else None
        if not isinstance(connection, dict):
            die("GitHub GraphQL response is missing issue fields")
        nodes = connection.get("nodes")
        page_info = connection.get("pageInfo")
        if not isinstance(nodes, list) or not isinstance(page_info, dict):
            die("GitHub issue field page is malformed")
        for field in nodes:
            if not isinstance(field, dict):
                die("issue field definition must be an object")
            field_id = field.get("fullDatabaseId")
            if isinstance(field_id, str) and re.fullmatch(r"[1-9][0-9]*", field_id):
                field_id = int(field_id)
            name = field.get("name")
            field_type = field.get("__typename")
            if (
                isinstance(field_id, bool)
                or not isinstance(field_id, int)
                or field_id <= 0
                or not isinstance(name, str)
                or not isinstance(field_type, str)
            ):
                die("issue field definition needs a numeric id, name, and type")
            if field_id in by_id:
                die(f"duplicate issue field definition: {field_id}")
            by_id[field_id] = (name, field_type)
        has_next = page_info.get("hasNextPage")
        end_cursor = page_info.get("endCursor")
        if not isinstance(has_next, bool):
            die("GitHub issue field pageInfo.hasNextPage must be boolean")
        if not has_next:
            break
        if not isinstance(end_cursor, str) or not end_cursor or end_cursor in seen_cursors:
            die("GitHub issue field pagination did not advance")
        seen_cursors.add(end_cursor)
        cursor = end_cursor
    result: dict[str, str] = {}
    for key, field_id in dict(profile["fields"]).items():
        if field_id not in by_id:
            die(f"configured field {key} ({field_id}) is not defined")
        name, field_type = by_id[field_id]
        if field_type != FIELD_TYPES[key]:
            die(
                f"configured field {key} ({field_id}) must be "
                f"{FIELD_TYPES[key]}, got {field_type}"
            )
        result[key] = name
    return result


def check_value_type(
    profile: dict[str, object],
    entry: dict[str, object],
    context: str,
) -> None:
    for key, field_id in dict(profile["fields"]).items():
        if entry.get("issue_field_id") != field_id:
            continue
        expected = VALUE_DATA_TYPES[FIELD_TYPES[key]]
        data_type = entry.get("data_type")
        if data_type != expected:
            die(
                f"configured field {key} ({field_id}) must be "
                f"{FIELD_TYPES[key]}, got {data_type} on {context}"
            )


def issues_path(profile: dict[str, object], page: int) -> str:
    return (
        f"repos/{profile['owner']}/{profile['name']}/issues"
        f"?state=open&sort=created&direction=asc&per_page={ISSUES_PAGE_SIZE}&page={page}"
    )


def normalized_issues(profile: dict[str, object]) -> list[dict[str, object]]:
    issues, pages = read_issue_pages(profile)
    if pages > 1:
        # Page numbers shift when an issue closes or reopens mid-read, which
        # can drop an issue without error, so repeat until two passes in a row
        # see the same issue numbers.
        for _ in range(ISSUE_READ_ATTEMPTS - 1):
            again, _pages = read_issue_pages(profile)
            agreed = sorted(again) == sorted(issues)
            issues = again
            if agreed:
                break
        else:
            die(f"open issues kept changing across {ISSUE_READ_ATTEMPTS} page reads")
    return [issues[number] for number in sorted(issues)]


def read_issue_pages(profile: dict[str, object]) -> tuple[dict[int, dict[str, object]], int]:
    # GitHub's Link headers point at numeric-ID paths that the cloud proxy
    # refuses, so page by number until a page comes back short.
    id_to_key = {field_id: key for key, field_id in dict(profile["fields"]).items()}
    issues: dict[int, dict[str, object]] = {}
    page = 1
    while True:
        items = gh_json([issues_path(profile, page)], str(profile["api_version"]))
        if not isinstance(items, list):
            die("GitHub issues page must be an array")
        for issue in items:
            if not isinstance(issue, dict):
                die("GitHub issue must be an object")
            if "pull_request" in issue:
                continue
            number = issue.get("number")
            title = issue.get("title")
            if isinstance(number, bool) or not isinstance(number, int) or number <= 0 or not isinstance(title, str):
                die("GitHub issue needs a positive number and title")
            if number in issues:
                continue
            values = issue.get("issue_field_values")
            if not isinstance(values, list):
                die(f"issue #{number} field values are missing or malformed")
            normalized: dict[str, object] = {
                "number": number,
                "title": title,
                "queue": None,
                "priority": None,
                "claim": None,
                "blocked_by": [],
                "touches": [],
            }
            seen_keys: set[str] = set()
            for field_value in values:
                if not isinstance(field_value, dict):
                    die(f"issue #{number} field value must be an object")
                field_id = field_value.get("issue_field_id")
                if isinstance(field_id, bool) or not isinstance(field_id, int) or field_id <= 0:
                    die(f"issue #{number} field value has malformed field identity")
                key = id_to_key.get(field_id)
                if key is None:
                    continue
                if key in seen_keys:
                    die(f"issue #{number} repeats configured field {key}")
                seen_keys.add(key)
                check_value_type(profile, field_value, f"issue #{number}")
                field_data = display_value(field_value)
                if not isinstance(field_data, str):
                    die(f"issue #{number} field {key} must be text")
                if key in {"blocked_by", "touches"}:
                    normalized[key] = field_data.split()
                else:
                    normalized[key] = field_data
            issues[number] = normalized
        if len(items) < ISSUES_PAGE_SIZE:
            return issues, page
        page += 1


def positive_issue(value: str) -> int:
    if re.fullmatch(r"[1-9][0-9]*", value) is None:
        die("issue must be a positive integer", 64)
    return int(value)


def values_path(profile: dict[str, object], issue: int) -> str:
    return f"repos/{profile['owner']}/{profile['name']}/issues/{issue}/issue-field-values"


def read_values(profile: dict[str, object], issue: int) -> list[dict[str, object]]:
    value = gh_json([values_path(profile, issue)], str(profile["api_version"]))
    if not isinstance(value, list):
        die("issue field values must be an array")
    seen: set[int] = set()
    for entry in value:
        if not isinstance(entry, dict):
            die("issue field value must be an object")
        field_id = entry.get("issue_field_id")
        if isinstance(field_id, bool) or not isinstance(field_id, int) or field_id <= 0:
            die("issue field value needs a positive field id")
        if field_id in seen:
            die(f"duplicate issue field value: {field_id}")
        seen.add(field_id)
        check_value_type(profile, entry, f"issue #{issue}")
    return value


def display_value(entry: dict[str, object]) -> object:
    if entry.get("data_type") == "single_select":
        option = entry.get("single_select_option")
        return option.get("name") if isinstance(option, dict) else None
    return entry.get("value")


def configured_output(
    profile: dict[str, object],
    issue: int,
    entries: list[dict[str, object]],
) -> dict[str, object]:
    by_id = {entry["issue_field_id"]: entry for entry in entries}
    values = {
        key: display_value(by_id[field_id]) if field_id in by_id else None
        for key, field_id in dict(profile["fields"]).items()
    }
    return {"issue": issue, "values": values}


def canonical(entry: dict[str, object]) -> str:
    return json.dumps(entry, sort_keys=True, separators=(",", ":"))


def verify_siblings(
    before: list[dict[str, object]],
    after: list[dict[str, object]],
    changed: set[int],
) -> None:
    before_map = {entry["issue_field_id"]: canonical(entry) for entry in before}
    after_map = {entry["issue_field_id"]: canonical(entry) for entry in after}
    before_siblings = {key: value for key, value in before_map.items() if key not in changed}
    after_siblings = {key: value for key, value in after_map.items() if key not in changed}
    if before_siblings != after_siblings:
        die("field write changed an unspecified sibling field")


def set_values(
    profile: dict[str, object],
    issue: int,
    assignments: list[str],
) -> dict[str, object]:
    parsed: dict[str, str] = {}
    for assignment in assignments:
        if "=" not in assignment:
            die("--value must be field=value", 64)
        key, value = assignment.split("=", 1)
        if key not in dict(profile["fields"]):
            die(f"unknown configured field: {key}", 64)
        if key in parsed:
            die(f"duplicate field assignment: {key}", 64)
        if not value:
            die(f"field {key} needs a nonempty value; use clear instead", 64)
        parsed[key] = value
    before = read_values(profile, issue)
    changed = {dict(profile["fields"])[key] for key in parsed}
    payload = {
        "issue_field_values": [
            {"field_id": dict(profile["fields"])[key], "value": value}
            for key, value in parsed.items()
        ]
    }
    gh_json(
        ["--method", "POST", values_path(profile, issue)],
        str(profile["api_version"]),
        payload,
    )
    after = read_values(profile, issue)
    verify_siblings(before, after, changed)
    after_map = {entry["issue_field_id"]: entry for entry in after}
    for key, expected in parsed.items():
        field_id = dict(profile["fields"])[key]
        if field_id not in after_map or display_value(after_map[field_id]) != expected:
            die(f"field {key} did not persist requested value")
    return configured_output(profile, issue, after)


def clear_value(
    profile: dict[str, object],
    issue: int,
    key: str,
) -> dict[str, object]:
    fields = dict(profile["fields"])
    if key not in fields:
        die(f"unknown configured field: {key}", 64)
    field_id = fields[key]
    before = read_values(profile, issue)
    if not any(entry["issue_field_id"] == field_id for entry in before):
        return configured_output(profile, issue, before)
    gh_json(
        ["--method", "DELETE", f"{values_path(profile, issue)}/{field_id}"],
        str(profile["api_version"]),
        allow_empty=True,
    )
    after = read_values(profile, issue)
    verify_siblings(before, after, {field_id})
    if any(entry["issue_field_id"] == field_id for entry in after):
        die(f"field {key} was not cleared")
    return configured_output(profile, issue, after)


def parser() -> Parser:
    result = Parser(prog="issue-fields")
    subcommands = result.add_subparsers(dest="command", required=True)
    list_parser = subcommands.add_parser("list")
    list_parser.add_argument("--profile", required=True)
    set_parser = subcommands.add_parser("set")
    set_parser.add_argument("--profile", required=True)
    set_parser.add_argument("--issue", required=True)
    set_parser.add_argument("--value", action="append", required=True)
    clear_parser = subcommands.add_parser("clear")
    clear_parser.add_argument("--profile", required=True)
    clear_parser.add_argument("--issue", required=True)
    clear_parser.add_argument("--field", required=True)
    return result


def main() -> None:
    args = parser().parse_args()
    profile = load_profile(args.profile)
    field_names(profile)
    if args.command == "list":
        output = normalized_issues(profile)
    elif args.command == "set":
        output = set_values(profile, positive_issue(args.issue), args.value)
    else:
        output = clear_value(profile, positive_issue(args.issue), args.field)
    print(json.dumps(output, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    main()
