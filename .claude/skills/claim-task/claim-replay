#!/usr/bin/env python3

import argparse
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn


QUEUE_STATES = {
    "Triage",
    "Waiting for input",
    "Ready",
    "In progress",
    "Needs review",
    "Under review",
    "Ready to merge",
}
HELD_STATES = {"In progress", "Under review"}
CYCLE_STATES = {"Ready": "In progress", "Needs review": "Under review"}
REF_SAFE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._-]*$")
SESSION_TOKEN_TEXT = r"[^:\x09-\x0d\x20<>]+"
ATTRIBUTION_FOOTER = re.compile(
    r"\n\n---\n_Generated by \[Claude Code\]\(https://claude\.ai/code\)_\n?\Z"
)
# Every prefix an agent profile has written, accepted beside the configured
# one in both directions: open issues whose generations predate a prefix change
# keep replaying under the new profile, and a session that read the old prefix
# before the change still replays comments written under the new one.
KNOWN_COMMENT_PREFIXES = ("[Agent]", "[Cursor]")
PRE_GENERATION_MARKER = re.compile(
    rf"<!-- claim:{SESSION_TOKEN_TEXT}:(In progress|Under review) -->(\n|\Z)"
)
SESSION_TOKEN = re.compile(rf"^{SESSION_TOKEN_TEXT}$")
GITHUB_PATTERNS = (
    (
        "claim-cycle",
        re.compile(
            r"^<!-- claim-cycle:(Ready|Needs review):"
            r"(root|[0-9A-Za-z][0-9A-Za-z._-]*) -->$"
        ),
    ),
    (
        "claim-cycle-activate",
        re.compile(
            r"^<!-- claim-cycle-activate:"
            r"([0-9A-Za-z][0-9A-Za-z._-]*) -->$"
        ),
    ),
    (
        "claim-marker",
        re.compile(
            rf"^<!-- claim:({SESSION_TOKEN_TEXT}):(In progress|Under review):"
            r"([0-9A-Za-z][0-9A-Za-z._-]*) -->$"
        ),
    ),
    (
        "claim",
        re.compile(
            rf"^<!-- claim-set:({SESSION_TOKEN_TEXT}):(In progress|Under review):"
            r"([0-9A-Za-z][0-9A-Za-z._-]*) -->$"
        ),
    ),
    (
        "claim-clear",
        re.compile(
            r"^<!-- claim-clear:(In progress|Under review):"
            r"([0-9A-Za-z][0-9A-Za-z._-]*) -->$"
        ),
    ),
)


class ReplayError(Exception):
    pass


def fail(message: str) -> NoReturn:
    raise ReplayError(message)


def require(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def load_json(path: str) -> object:
    try:
        if path == "-":
            return json.load(sys.stdin, object_pairs_hook=unique_object)
        with Path(path).open(encoding="utf-8") as handle:
            return json.load(handle, object_pairs_hook=unique_object)
    except (OSError, UnicodeError) as error:
        fail(f"cannot read input: {error}")
    except json.JSONDecodeError as error:
        fail(
            f"invalid input JSON: {error.msg} at line "
            f"{error.lineno} column {error.colno}"
        )
    except ValueError as error:
        fail(f"invalid input JSON: {error}")


def parse_time(value: object, name: str) -> datetime:
    require(isinstance(value, str) and bool(value), f"{name} must be a timestamp")
    normalized = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        fail(f"{name} must be an ISO-8601 timestamp")
    require(parsed.tzinfo is not None, f"{name} must include a timezone")
    return parsed.astimezone(timezone.utc)


def ref_safe(value: object, name: str) -> str:
    require(
        isinstance(value, str) and REF_SAFE.fullmatch(value) is not None,
        f"{name} must be ref-safe",
    )
    return value


def validate_event(value: object) -> dict[str, object]:
    require(isinstance(value, dict), "every protocol event must be an object")
    version = value.get("version")
    require(
        isinstance(version, int)
        and not isinstance(version, bool)
        and version == 1,
        "event version must be the integer 1",
    )
    ref_safe(value.get("event_id"), "event_id")
    kind = value.get("kind")
    require(
        kind
        in {
            "claim-cycle",
            "claim-cycle-activate",
            "claim-marker",
            "claim",
            "touches",
        },
        "unknown protocol event kind",
    )
    if kind == "claim-cycle":
        require(
            set(value)
            in (
                {"version", "event_id", "kind", "state"},
                {"version", "event_id", "kind", "state", "predecessor"},
            ),
            "claim-cycle event has unknown or missing fields",
        )
        require(
            value.get("state") in CYCLE_STATES,
            "claim-cycle state must be Ready or Needs review",
        )
        if "predecessor" in value:
            predecessor = value["predecessor"]
            require(
                predecessor is None
                or isinstance(predecessor, str)
                and REF_SAFE.fullmatch(predecessor) is not None,
                "claim-cycle predecessor must be null or ref-safe",
            )
    elif kind == "claim-cycle-activate":
        require(
            set(value) == {"version", "event_id", "kind", "generation"},
            "claim-cycle-activate event has unknown or missing fields",
        )
        ref_safe(value.get("generation"), "claim-cycle activation generation")
    elif kind == "claim-marker":
        require(
            set(value)
            in (
                {"version", "event_id", "kind", "session", "state"},
                {
                    "version",
                    "event_id",
                    "kind",
                    "session",
                    "state",
                    "generation",
                },
            ),
            "claim-marker event has unknown or missing fields",
        )
        session = value.get("session")
        require(
            isinstance(session, str)
            and SESSION_TOKEN.fullmatch(session) is not None,
            "claim-marker session must be a session token",
        )
        require(
            value.get("state") in HELD_STATES,
            "claim-marker state must be In progress or Under review",
        )
        if "generation" in value:
            ref_safe(value["generation"], "claim-marker generation")
    elif kind == "claim":
        require(
            set(value)
            in (
                {"version", "event_id", "kind", "value"},
                {
                    "version",
                    "event_id",
                    "kind",
                    "value",
                    "state",
                    "generation",
                },
            ),
            "claim event has unknown or missing fields",
        )
        claim_value = value.get("value")
        require(isinstance(claim_value, str), "claim value must be a string")
        require(
            claim_value == ""
            or SESSION_TOKEN.fullmatch(claim_value) is not None,
            "nonempty claim value must be a session token",
        )
        if "generation" in value:
            require(
                value.get("state") in HELD_STATES,
                "claim state must be In progress or Under review",
            )
            ref_safe(value["generation"], "claim generation")
    else:
        require(
            set(value) == {"version", "event_id", "kind", "value"},
            "touches event has unknown or missing fields",
        )
        touches = value.get("value")
        require(isinstance(touches, list), "touches value must be an array")
        require(
            all(isinstance(path, str) and bool(path.strip()) for path in touches),
            "touches paths must be nonblank strings",
        )
        require(len(touches) == len(set(touches)), "touches paths must be unique")
    return value


def normalized_records(document: object) -> list[dict[str, object]]:
    require(isinstance(document, dict), "event input must be an object")
    require(
        set(document) == {"format", "events"},
        "event input has unknown or missing fields",
    )
    require(
        document.get("format") == "claim-protocol-events-v1",
        "event input must use claim-protocol-events-v1",
    )
    records = document.get("events")
    require(isinstance(records, list), "events must be an array")
    normalized: list[dict[str, object]] = []
    source_ids: set[str] = set()
    event_ids: set[str] = set()
    stable_keys: set[tuple[str, object]] = set()
    for record in records:
        require(isinstance(record, dict), "every event record must be an object")
        require(
            set(record) == {"source_id", "created_at", "stable_key", "event"},
            "event record has unknown or missing fields",
        )
        source_id = record["source_id"]
        require(
            isinstance(source_id, str) and bool(source_id),
            "event source_id must be nonblank",
        )
        require(source_id not in source_ids, "duplicate event source_id")
        source_ids.add(source_id)
        created = parse_time(record["created_at"], "event created_at")
        stable = record["stable_key"]
        if isinstance(stable, bool) or not isinstance(stable, (int, str)):
            fail("event stable_key must be an integer or string")
        if isinstance(stable, int):
            require(stable > 0, "integer stable_key must be positive")
            stable_identity: tuple[str, object] = ("integer", stable)
            stable_sort: tuple[int, object] = (0, stable)
        else:
            require(bool(stable), "string stable_key must be nonblank")
            stable_identity = ("string", stable)
            stable_sort = (1, stable)
        require(stable_identity not in stable_keys, "duplicate event stable_key")
        stable_keys.add(stable_identity)
        event = validate_event(record["event"])
        event_id = event["event_id"]
        require(event_id not in event_ids, "duplicate event_id")
        event_ids.add(event_id)
        normalized.append(
            {
                "source_id": source_id,
                "created_at": record["created_at"],
                "created": created,
                "stable_sort": stable_sort,
                "event": event,
            }
        )
    return sorted(
        normalized,
        key=lambda record: (record["created"], record["stable_sort"]),
    )


def transition(
    queue_state: str,
    generation: dict[str, object] | None,
) -> dict[str, object]:
    if queue_state in CYCLE_STATES:
        if generation is None or generation["queue_state"] != queue_state:
            return {
                "claimable": False,
                "reason": "Queue visit has no matching activated generation",
                "status": "incomplete",
            }
        if generation["visited"]:
            return {
                "claimable": False,
                "reason": "Queue re-entry requires an activated successor",
                "status": "incomplete",
            }
        return {"claimable": True, "status": "ready"}
    if queue_state in HELD_STATES:
        if generation is None or generation["state"] != queue_state:
            return {
                "claimable": False,
                "reason": "held Queue state has no matching activated generation",
                "status": "incomplete",
            }
        return {"claimable": False, "status": "held"}
    return {"claimable": False, "status": "inactive"}


def replay(
    document: object,
    queue_state: str,
    claim_projection: str | None,
) -> dict[str, object]:
    require(queue_state in QUEUE_STATES, "queue-state must be a known Queue value")
    ordered = normalized_records(document)
    indexed = [
        (order, record, record["event"])
        for order, record in enumerate(ordered, start=1)
    ]
    cycles: dict[str, tuple[dict[str, object], int]] = {}
    legacy_cycles: list[tuple[dict[str, object], int]] = []
    activations: dict[
        str, tuple[dict[str, object], int]
    ] = {}
    for order, _, event in indexed:
        kind = event["kind"]
        if kind == "claim-cycle":
            event_id = event["event_id"]
            cycles[event_id] = (event, order)
            if "predecessor" not in event:
                legacy_cycles.append((event, order))
        elif kind == "claim-cycle-activate":
            generation = event["generation"]
            require(
                generation not in activations,
                "duplicate activation for one claim-cycle",
            )
            activations[generation] = (event, order)

    for generation, (_, activation_order) in activations.items():
        require(
            generation in cycles,
            "claim-cycle activation references a missing intent",
        )
        cycle, cycle_order = cycles[generation]
        require(
            "predecessor" in cycle,
            "legacy claim-cycle cannot be activated",
        )
        require(
            cycle_order < activation_order,
            "claim-cycle intent must precede its activation",
        )

    children: dict[
        str | None,
        list[
            tuple[
                dict[str, object],
                int,
                dict[str, object],
                int,
            ]
        ],
    ] = {}
    for generation, (cycle_entry, cycle_order) in cycles.items():
        if "predecessor" not in cycle_entry:
            continue
        predecessor = cycle_entry["predecessor"]
        if predecessor is not None:
            require(
                predecessor in cycles,
                "claim-cycle predecessor references a missing intent",
            )
            predecessor_cycle, predecessor_order = cycles[predecessor]
            require(
                "predecessor" in predecessor_cycle,
                "claim-cycle predecessor cannot be a legacy intent",
            )
            require(
                predecessor_order < cycle_order,
                "claim-cycle predecessor must precede its successor intent",
            )
            require(
                predecessor in activations,
                "claim-cycle predecessor must be activated",
            )
            require(
                activations[predecessor][1] < cycle_order,
                "claim-cycle successor intent must follow predecessor activation",
            )
        activation = activations.get(generation)
        if activation is None:
            continue
        activation_event, activation_order = activation
        children.setdefault(predecessor, []).append(
            (
                cycle_entry,
                cycle_order,
                activation_event,
                activation_order,
            )
        )
    for candidates in children.values():
        candidates.sort(
            key=lambda candidate: (
                candidate[3],
                candidate[2]["event_id"],
            )
        )

    selected: list[
        tuple[dict[str, object], int, dict[str, object], int]
    ] = []
    roots = children.get(None, [])
    if roots:
        current = roots[0]
        require(
            all(order < current[1] for _, order in legacy_cycles),
            "legacy claim-cycle history needs a later activated root repair",
        )
        selected.append(current)
        while children.get(current[0]["event_id"]):
            current = children[current[0]["event_id"]][0]
            selected.append(current)
    else:
        require(
            not activations,
            "activated claim-cycle chain has no root",
        )

    generations: dict[str, str | None] = {
        "In progress": None,
        "Under review": None,
    }
    for cycle, _, _, _ in selected:
        generations[CYCLE_STATES[cycle["state"]]] = cycle["event_id"]

    active: dict[str, object] | None = None
    active_intent_order = 0
    active_generation = None
    if selected:
        cycle, active_intent_order, activation, _ = selected[-1]
        active_generation = cycle["event_id"]
        active = {
            "activation_id": activation["event_id"],
            "id": active_generation,
            "predecessor": cycle["predecessor"],
            "queue_state": cycle["state"],
            "state": CYCLE_STATES[cycle["state"]],
            "visited": False,
        }

    claim_event: dict[str, object] | None = None
    touches: list[str] = []
    markers: list[dict[str, object]] = []
    for order, record, event in indexed:
        kind = event["kind"]
        if kind == "touches":
            touches = event["value"]
            continue
        if kind not in {"claim", "claim-marker"}:
            continue
        generation = event.get("generation")
        if generation is None:
            if active is not None:
                require(
                    order < active_intent_order,
                    f"legacy {kind} is missing the active generation",
                )
            continue
        require(
            generation in cycles,
            f"{kind} generation references a missing claim-cycle",
        )
        cycle, cycle_order = cycles[generation]
        require(
            CYCLE_STATES[cycle["state"]] == event["state"],
            f"{kind} generation does not match its held state",
        )
        require(
            cycle_order < order,
            f"claim-cycle intent must precede its {kind}",
        )
        if generation not in activations:
            if active is not None and order < active_intent_order:
                continue
            fail(f"{kind} must reference an activated generation")
        require(
            activations[generation][1] < order,
            f"claim-cycle activation must precede its {kind}",
        )
        if kind == "claim-marker":
            markers.append(
                {
                    "created_at": record["created_at"],
                    "generation": generation,
                    "order": order,
                    "session": event["session"],
                    "state": event["state"],
                }
            )
        elif generation == active_generation:
            active["visited"] = True
            claim_event = event

    claim = None
    if claim_event is not None and claim_event["value"]:
        claim = {
            "generation": claim_event["generation"],
            "state": claim_event["state"],
            "value": claim_event["value"],
        }
    result: dict[str, object] = {
        "claim": claim,
        "generation": active,
        "generations": generations,
        "markers": markers,
        "projection": None,
        "touches": touches,
        "transition": transition(queue_state, active),
    }
    if claim_projection is not None:
        desired = "" if claim is None else claim["value"]
        result["projection"] = {
            "actual": claim_projection,
            "desired": desired,
            "write": claim_projection != desired,
        }
    return result


def github_event(
    database_id: int,
    body: str,
    comment_prefix: str,
    attributed_seen: bool,
    protocol_seen: bool,
) -> tuple[dict[str, object] | None, bool, bool]:
    body, attributed = normalized_github_body(body, comment_prefix)
    if not protocol_seen and PRE_GENERATION_MARKER.match(body):
        return None, attributed_seen, protocol_seen
    kind, match = github_pattern(body)
    if match is None:
        require(
            "<!-- claim" not in body,
            "malformed GitHub claim protocol comment",
        )
        return None, attributed_seen, protocol_seen
    if attributed:
        attributed_seen = True
    else:
        require(not attributed_seen, "GitHub protocol comment is missing configured prefix")
    event_id = str(database_id)
    payload: dict[str, object] = {
        "version": 1,
        "event_id": event_id,
    }
    groups = match.groups()
    if kind == "claim-cycle":
        state, predecessor = groups
        payload.update(
            {
                "kind": kind,
                "state": state,
                "predecessor": None if predecessor == "root" else predecessor,
            }
        )
    elif kind == "claim-cycle-activate":
        payload.update({"kind": kind, "generation": groups[0]})
    elif kind == "claim-marker":
        session, state, generation = groups
        payload.update(
            {
                "kind": kind,
                "session": session,
                "state": state,
                "generation": generation,
            }
        )
    elif kind == "claim":
        session, state, generation = groups
        payload.update(
            {
                "kind": kind,
                "value": session,
                "state": state,
                "generation": generation,
            }
        )
    else:
        state, generation = groups
        payload.update(
            {
                "kind": "claim",
                "value": "",
                "state": state,
                "generation": generation,
            }
        )
    return payload, attributed_seen, True


def normalized_github_body(body: str, comment_prefix: str) -> tuple[str, bool]:
    expected_prefix = f"{comment_prefix} "
    known_prefix = next(
        (f"{known} " for known in KNOWN_COMMENT_PREFIXES if body.startswith(f"{known} ")),
        None,
    )
    if known_prefix is not None and not body.startswith(expected_prefix):
        expected_prefix = known_prefix
    attributed = False
    if body.startswith(expected_prefix):
        body = body[len(expected_prefix) :]
        attributed = True
    body = ATTRIBUTION_FOOTER.sub("", body, count=1)
    body = body.removesuffix("\n")
    return body, attributed


def github_pattern(body: str) -> tuple[str | None, re.Match[str] | None]:
    for candidate_kind, pattern in GITHUB_PATTERNS:
        candidate = pattern.fullmatch(body)
        if candidate is not None:
            return candidate_kind, candidate
    return None, None


def github_comments(
    document: object,
) -> tuple[list[dict[str, object]], str]:
    require(isinstance(document, dict), "GitHub comment input must be an object")
    require(
        set(document) == {"format", "claim_projection", "comments"},
        "GitHub comment input has unknown or missing fields",
    )
    require(
        document.get("format") == "github-claim-comments-v1",
        "GitHub comments must use github-claim-comments-v1",
    )
    projection = document.get("claim_projection")
    require(
        isinstance(projection, str),
        "GitHub Claim projection must be a string",
    )
    comments = document.get("comments")
    require(isinstance(comments, list), "GitHub comments must be an array")
    seen_ids: set[int] = set()
    normalized_comments: list[dict[str, object]] = []
    for comment in comments:
        require(isinstance(comment, dict), "every GitHub comment must be an object")
        database_id = comment.get("databaseId")
        require(
            isinstance(database_id, int)
            and not isinstance(database_id, bool)
            and database_id > 0,
            "every GitHub comment needs a positive numeric databaseId",
        )
        require(database_id not in seen_ids, "duplicate GitHub comment databaseId")
        seen_ids.add(database_id)
        body = comment.get("body")
        require(isinstance(body, str), "every GitHub comment body must be a string")
        created = parse_time(comment.get("createdAt"), "GitHub comment createdAt")
        updated = parse_time(comment.get("updatedAt"), "GitHub comment updatedAt")
        normalized_comments.append(
            {
                "body": body,
                "created": created,
                "created_at": comment["createdAt"],
                "database_id": database_id,
                "updated": updated,
            }
        )
    return sorted(
        normalized_comments,
        key=lambda value: (value["created"], value["database_id"]),
    ), projection


def github_records_from_comments(
    comments: list[dict[str, object]],
    comment_prefix: str,
) -> dict[str, object]:
    records: list[dict[str, object]] = []
    attributed_seen = False
    protocol_seen = False
    for comment in comments:
        database_id = comment["database_id"]
        event, attributed_seen, protocol_seen = github_event(
            database_id,
            comment["body"],
            comment_prefix,
            attributed_seen,
            protocol_seen,
        )
        if event is None:
            continue
        require(
            comment["created"] == comment["updated"],
            "edited GitHub protocol comments fail closed",
        )
        records.append(
            {
                "source_id": str(database_id),
                "created_at": comment["created_at"],
                "stable_key": database_id,
                "event": event,
            }
        )
    return {
        "format": "claim-protocol-events-v1",
        "events": records,
    }


def github_records(
    document: object,
    comment_prefix: str,
) -> tuple[dict[str, object], str]:
    comments, projection = github_comments(document)
    return github_records_from_comments(comments, comment_prefix), projection


def recover_github_root(
    document: object,
    queue_state: str,
    comment_prefix: str,
) -> dict[str, object]:
    comments, projection = github_comments(document)
    malformed_orders: list[int] = []
    roots: list[tuple[int, dict[str, object]]] = []
    activations: dict[str, list[dict[str, object]]] = {}
    for order, comment in enumerate(comments):
        body, _ = normalized_github_body(comment["body"], comment_prefix)
        kind, match = github_pattern(body)
        marker_like = "<!-- claim" in body
        if marker_like and match is None and PRE_GENERATION_MARKER.match(body) is None:
            malformed_orders.append(order)
            continue
        if match is not None and comment["created"] != comment["updated"]:
            malformed_orders.append(order)
            continue
        if kind == "claim-cycle" and match is not None and match.groups()[1] == "root":
            roots.append((order, comment))
        elif kind == "claim-cycle-activate" and match is not None:
            activations.setdefault(match.groups()[0], []).append(comment)

    last_malformed = max(malformed_orders, default=-1)
    activatable_roots: list[
        tuple[datetime, int, int, dict[str, object], dict[str, object]]
    ] = []
    for order, root in roots:
        if order <= last_malformed:
            continue
        generation = str(root["database_id"])
        for activation in activations.get(generation, []):
            if (
                activation["created"],
                activation["database_id"],
            ) <= (
                root["created"],
                root["database_id"],
            ):
                continue
            activatable_roots.append(
                (
                    activation["created"],
                    activation["database_id"],
                    order,
                    root,
                    activation,
                )
            )
    require(
        bool(activatable_roots),
        "no activated root exists after malformed GitHub claim history",
    )
    activatable_roots.sort(key=lambda candidate: (candidate[2], candidate[0], candidate[1]))
    last_error: ReplayError | None = None
    for boundary in sorted({candidate[2] for candidate in activatable_roots}):
        eligible = [
            candidate
            for candidate in activatable_roots
            if candidate[2] >= boundary
        ]
        eligible.sort(key=lambda candidate: (candidate[0], candidate[1]))
        _, _, _, winner_root, winner_activation = eligible[0]
        try:
            document_events = github_records_from_comments(
                comments[boundary:],
                comment_prefix,
            )
            result = replay(document_events, queue_state, projection)
        except ReplayError as error:
            last_error = error
            continue
        result["recovery"] = {
            "fenced_source_ids": [
                str(comment["database_id"]) for comment in comments[:boundary]
            ],
            "root_activation": str(winner_activation["database_id"]),
            "root_generation": str(winner_root["database_id"]),
        }
        return result
    require(last_error is not None, "activated root recovery failed")
    fail(f"activated root recovery failed: {last_error}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="claim-replay")
    parser.add_argument("command", choices=("events", "github"))
    parser.add_argument("--input", required=True)
    parser.add_argument("--queue-state", required=True)
    parser.add_argument("--comment-prefix")
    parser.add_argument("--recover-root", action="store_true")
    parser.add_argument("--json", action="store_true")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    document = load_json(args.input)
    projection = None
    require(
        not args.recover_root or args.command == "github",
        "--recover-root is only valid with github",
    )
    if args.command == "github":
        prefix_match = (
            re.fullmatch(r"\[([^\]\[\r\n]+)\]", args.comment_prefix)
            if isinstance(args.comment_prefix, str)
            else None
        )
        require(
            prefix_match is not None and bool(prefix_match.group(1).strip()),
            "comment-prefix must be a nonempty [Name]-style prefix",
        )
        if args.recover_root:
            result = recover_github_root(
                document,
                args.queue_state,
                args.comment_prefix,
            )
        else:
            document, projection = github_records(document, args.comment_prefix)
            result = replay(document, args.queue_state, projection)
    else:
        result = replay(document, args.queue_state, projection)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except ReplayError as error:
        print(f"claim-replay: {error}", file=sys.stderr)
        raise SystemExit(64)
