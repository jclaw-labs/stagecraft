{
  "name": "@jclaw-labs/musician-site",
  "version": "1.0.0-rc.0",
  "description": "The Stagecraft musician site: public renderer, /admin CMS, API routes and content pipeline for Next.js.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jclaw-labs/stagecraft.git",
    "directory": "templates/musician-site"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#lib/*": {
      "source": "./src/lib/*",
      "default": "./dist/lib/*"
    },
    "#components/*": {
      "source": "./src/components/*",
      "default": "./dist/components/*"
    },
    "#puck/*": {
      "source": "./src/puck/*",
      "default": "./dist/puck/*"
    }
  },
  "exports": {
    "./globals.css": "./dist/app/globals.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__snapshots__"
  ],
  "bin": {
    "stagecraft-site": "./dist/cli/stagecraft-site.js"
  },
  "stagecraft": {
    "schemaVersion": 1
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:screenshots": "playwright test --config playwright.capture.config.ts",
    "refresh:demo": "node scripts/refresh-demo-content.mjs",
    "build:package": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "next": ">=15.5.27 <16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@jclaw-labs/content-upgraders": "file:../../packages/content-upgraders",
    "@octokit/rest": "22.0.1",
    "@puckeditor/core": "0.23.0",
    "isomorphic-dompurify": "3.14.0",
    "jose": "6.2.3",
    "resend": "6.32.1",
    "sharp": "0.35.5",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
