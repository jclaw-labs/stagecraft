# Monorepo only: install the package from ../musician-site as a packed copy,
# the way an artist site installs it from npm, so its dependencies land in
# this node_modules. With a symlink, Next.js would bundle them from the
# template's node_modules instead. Generated sites install from npm and get
# no .npmrc.
install-links=true
# Sites ship no lockfile (ADR-016 §2), and neither does the shell.
package-lock=false
